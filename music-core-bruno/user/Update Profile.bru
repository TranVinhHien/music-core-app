meta {
  name: Update Profile
  type: http
  seq: 4
}

put {
  url: {{base_url}}/api/v1/auth/me
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "full_name": "Updated Test User",
    "phone_number": "0987654321",
    "home_address": "123 Street, City",
    "avatar_url": "https://example.com/avatar.png"
  }
}
