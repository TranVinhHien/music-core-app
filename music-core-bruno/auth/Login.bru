meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "vinhhien12z@gmail.com",
    "password": "123456"
  }
}

script:post-response {
  const body = res.getBody();
  
  if (body && body.code === "200" && body.data && body.data.token) {
    
    bru.setVar("token", body.data.token);
    bru.setVar("refresh_token",body.data.refresh_token)
    console.log("Đã lưu accessToken thành công:", body.data.token);
    
  } else {
    console.log("Không tìm thấy token trong phản hồi API.");
  }
}
