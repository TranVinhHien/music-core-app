meta {
  name: Get All Playlists
  type: http
  seq: 2
}

get {
  url: {{base_url}}/api/v1/library/playlists?page=1&limit=10&order=desc
  body: none
  auth: inherit
}

params:query {
  page: 1
  limit: 10
  order: desc
  ~visibility: PUBLIC
  ~query: Chill
}

headers {
  Authorization: Bearer {{token}}
}
