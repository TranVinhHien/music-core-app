meta {
  name: Update Artist
  type: http
  seq: 4
}

put {
  url: {{base_url}}/api/v1/catalog/artists/:id
  body: json
  auth: inherit
}

params:path {
  id: PASTE_ARTIST_ID_HERE
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "name": "Sơn Tùng M-TP (Official)",
    "bio": "Cập nhật tiểu sử nghệ sĩ Sơn Tùng M-TP",
    "imageUrl": "https://example.com/artists/son-tung-updated.jpg"
  }
}
