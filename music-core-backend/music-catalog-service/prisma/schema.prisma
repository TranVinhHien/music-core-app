// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Artist {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String        @db.VarChar(255)
  normalizedName String        @map("normalized_name") @db.VarChar(255)
  bio            String?       @db.Text
  imageUrl       String?       @map("image_url") @db.Text
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  trackArtists   TrackArtist[]
  albumArtists   AlbumArtist[]

  @@index([normalizedName], map: "idx_artists_normalized_name")
  @@map("artists")
}

model Album {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title         String        @db.VarChar(255)
  releaseDate   DateTime?     @map("release_date") @db.Date
  coverImageUrl String?       @map("cover_image_url") @db.Text
  status        String        @default("ACTIVE") @db.VarChar(20)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  tracks        Track[]
  albumArtists  AlbumArtist[]

  @@index([title], map: "idx_albums_title")
  @@map("albums")
}

model Track {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String        @db.VarChar(255)
  slug        String?       @db.VarChar(255)
  albumId     String?       @map("album_id") @db.Uuid
  durationMs  Int?          @map("duration_ms")
  trackNumber Int?          @map("track_number")
  discNumber  Int?          @map("disc_number")
  releaseDate DateTime?     @map("release_date") @db.Date
  coverImageUrl String?     @map("cover_image_url") @db.Text
  fileUrl     String?       @map("file_url") @db.Text
  status      String        @default("ACTIVE") @db.VarChar(20)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  album       Album?        @relation(fields: [albumId], references: [id], onDelete: SetNull)
  trackArtists TrackArtist[]
  trackGenres  TrackGenre[]
  trackSources TrackSource[]
  audioAnalysis TrackAudioAnalysis?

  @@index([title], map: "idx_tracks_title")
  @@index([albumId], map: "idx_tracks_album_id")
  @@index([status], map: "idx_tracks_status")
  @@map("tracks")
}

model Genre {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String       @db.VarChar(100)
  slug      String       @unique @db.VarChar(100)
  parentId  String?      @map("parent_id") @db.Uuid
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz()

  parent    Genre?       @relation("GenreHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  Genre[]      @relation("GenreHierarchy")
  trackGenres TrackGenre[]

  @@map("genres")
}

model TrackArtist {
  trackId   String  @map("track_id") @db.Uuid
  artistId  String  @map("artist_id") @db.Uuid
  role      String  @default("PRIMARY") @db.VarChar(30)
  position  Int     @default(1) @db.SmallInt

  track     Track   @relation(fields: [trackId], references: [id], onDelete: Cascade)
  artist    Artist  @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([trackId, artistId, role])
  @@index([artistId], map: "idx_track_artists_artist_id")
  @@map("track_artists")
}

model AlbumArtist {
  albumId   String  @map("album_id") @db.Uuid
  artistId  String  @map("artist_id") @db.Uuid
  position  Int     @default(1) @db.SmallInt

  album     Album   @relation(fields: [albumId], references: [id], onDelete: Cascade)
  artist    Artist  @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([albumId, artistId])
  @@index([artistId], map: "idx_album_artists_artist_id")
  @@map("album_artists")
}

model TrackGenre {
  trackId String @map("track_id") @db.Uuid
  genreId String @map("genre_id") @db.Uuid

  track   Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([trackId, genreId])
  @@index([genreId], map: "idx_track_genres_genre_id")
  @@map("track_genres")
}

model TrackSource {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  trackId     String   @map("track_id") @db.Uuid
  source      String   @db.VarChar(50)
  externalId  String   @map("external_id") @db.VarChar(255)
  externalUrl String?  @map("external_url") @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  track       Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([source, externalId])
  @@index([trackId], map: "idx_track_sources_track_id")
  @@map("track_sources")
}

model TrackAudioAnalysis {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  trackId               String    @unique @map("track_id") @db.Uuid
  cueInMs               Int       @default(0) @map("cue_in_ms")
  cueOutMs              Int       @map("cue_out_ms")
  durationMs            Int       @map("duration_ms")
  bpm                   Float?    @db.Real
  firstDownbeatMs       Int?      @map("first_downbeat_ms")
  downbeats             Json?     @db.JsonB
  key                   String?   @db.VarChar(10)
  scale                 String?   @db.VarChar(10)
  camelotKey            String?   @map("camelot_key") @db.VarChar(10)
  energy                Float?    @db.Real
  loudnessLufs          Float?    @map("loudness_lufs") @db.Real
  recommendedTransition String?   @map("recommended_transition") @db.VarChar(50)
  recommendedCrossfadeMs Int?     @map("recommended_crossfade_ms")
  analysisStatus        String    @default("PENDING") @map("analysis_status") @db.VarChar(20)
  errorMessage          String?   @map("error_message") @db.Text
  analyzedAt            DateTime? @map("analyzed_at") @db.Timestamptz()
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  track                 Track     @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([analysisStatus], map: "idx_track_audio_analysis_status")
  @@map("track_audio_analyses")
}

