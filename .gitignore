# ==============================================================================
# Environment & Secret Configuration Files
# ==============================================================================
.env
.env.*
!.env.example
!.env.*.example

# Local configuration overrides
*.local.yaml
*.local.yml
*.*.local.yaml
*.*.local.yml

# Active development & production configs with secrets (applies to all subdirectories)
app.development.yaml
app.development.yml
gateway.development.yaml
gateway.development.yml
app.production.yaml
app.production.yml
gateway.production.yaml
gateway.production.yml

# Generic pattern for any current or future microservice configs
*.development.yaml
*.development.yml
*.production.yaml
*.production.yml

# Never ignore example template files
!*.example.yaml
!*.example.yml

